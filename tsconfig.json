{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": false,
		"noEmit": true
	},
	"include": ["src/**/*", "profiling-matrix.config.ts"],
	"exclude": ["node_modules"]
}
